      "targets": [
        {
          "expr": "node_hwmon_temp_celsius{instance=~\"$instance\"} * on(chip,instance,job) group_left(chip_name) node_hwmon_chip_names{instance=~\"$instance\", chip_name=\"coretemp\"} * on(chip,sensor,instance,job) group_left(label) node_hwmon_sensor_label{instance=~\"$instance\", label=~\"Package.*\"}",
          "refId": "A"
        }
      ],
      "title": "CPU Package Temp",
      "type": "stat"
    },
